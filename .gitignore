# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Temporary & backup files
*~
*.sw[mnpcod]
*.tmp
*.tmp.*
.tmp

# Logs
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
/libpeerconnection.log

# Dependencies
/node_modules/

# Compiled outputs
/www/
/dist/
/out-tsc/
/bazel-out/
/tmp/

# Angular & build caches
/.angular/cache/
/.sass-cache/
/.nx/cache/

# Coverage & test results
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Ionic & Cordova
/.ionic/
/platforms/
/plugins/

# Capacitor (archivos de compilación y claves si se agregan plataformas nativas)
# Si compilas android o ios, ignora artefactos de build y claves privadas
android/app/build/
android/.gradle/
android/build/
android/captures/
android/.idea/
ios/App/App/public/
ios/App/Pods/
ios/App/Podfile.lock
ios/App/build/
*.keystore
*.jks

# Environment variables & secrets
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
UserInterfaceState.xcuserstate
